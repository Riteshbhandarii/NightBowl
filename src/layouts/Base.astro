---
import '../styles/global.css';
import { SITE } from '../data/content';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
}
const {
  title,
  description = "Ritesh Bhandari — portfolio and kitchen log, served from a late-night ramen stall.",
  bodyClass,
  noindex = false,
} = Astro.props;
const pageTitle = `${title} · ${SITE.ownerName}`;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const shareImage = canonical ? new URL('/images/nightbowl-share.png', Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <>
      <meta property="og:image" content={shareImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="NightBowl, Ritesh Bhandari's interactive late-night ramen-stall portfolio" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={shareImage} />
    </>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,500;0,700;1,400&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,700;1,400&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
