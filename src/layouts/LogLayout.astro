---
import Base from './Base.astro';
import { LOG, SITE } from '../data/content';
import '../styles/log.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<Base title={`${title} · ${SITE.name}`} description={description} bodyClass="reading-page" noindex={noindex}>
  <header class="log-header">
    <a class="log-brand" href="/">{SITE.name}</a>
    <nav aria-label={LOG.title}>
      <a href="/log/">{LOG.title}</a>
      <a href="/">{LOG.backToStall}</a>
    </nav>
  </header>
  <slot />
</Base>
