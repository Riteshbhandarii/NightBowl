---
import ReadingLayout from './ReadingLayout.astro';
import '../styles/log.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<ReadingLayout title={title} description={description} noindex={noindex}>
  <slot />
</ReadingLayout>
