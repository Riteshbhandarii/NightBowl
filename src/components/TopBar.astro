---
import { NAVIGATION } from '../data/content';
---

<header class="topbar">
  <nav class="nav" aria-label="Sections">
    <button data-open="menu">{NAVIGATION.menu}</button>
    <button data-open="guide">{NAVIGATION.guide}</button>
    <button data-open="log">{NAVIGATION.log}</button>
    <button data-open="bill">{NAVIGATION.bill}</button>
  </nav>

  <button class="menu-toggle" data-open="menu" aria-haspopup="dialog">{NAVIGATION.openMenu}</button>
</header>

<script>
  document.querySelectorAll('[data-open]').forEach((b) => {
    b.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('nb:open', { detail: (b as HTMLElement).dataset.open }));
    });
  });

</script>
