---
// The 3D ramen stall. All wiring lives in ../lib/scene.js
import { getCollection } from 'astro:content';
import { CHATTER, NAVIGATION, SCENE, SITE } from '../data/content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({ name: project.data.name, tag: project.data.tag }));
const sceneContent = {
  chatter: CHATTER,
  labels: {
    ...SCENE,
    siteName: SITE.name,
    siteInitial: SITE.name.charAt(0).toUpperCase(),
    navigation: NAVIGATION,
  },
  menuItems: projects,
};
// A script is a raw-text HTML element even when its type is application/json.
// Escape '<' so literal CMS text cannot close it; JSON.parse restores the text.
const sceneJson = JSON.stringify(sceneContent).replace(/</g, '\\u003c');
---

<script id="nbSceneContent" type="application/json" set:html={sceneJson} is:inline></script>
<canvas id="scene" aria-label={SCENE.canvasLabel}></canvas>
<button
  type="button"
  class="scene-motion-control"
  id="sceneMotionControl"
  data-state="unavailable"
  aria-label="Scene motion unavailable"
  aria-pressed="false"
  disabled
><span>Motion unavailable</span></button>
<div class="loading" id="loading" data-error={SCENE.error}>{SCENE.loading}</div>
<div class="pins" id="pins"></div>
<aside class="visitor-order" id="visitorOrder" aria-labelledby="visitorOrderTitle" hidden>
  <h2 id="visitorOrderTitle">{SCENE.orderTitle}</h2>
  <div id="visitorOrderChoices" class="visitor-order-choices">
    <button type="button" data-visitor-dish="house"><span>{SCENE.orderHouse}</span><small>{SCENE.orderHouseNote}</small></button>
    <button type="button" data-visitor-dish="veggie"><span>{SCENE.orderVeggie}</span><small>{SCENE.orderVeggieNote}</small></button>
  </div>
  <p id="visitorOrderStatus" role="status" aria-live="polite" aria-atomic="true"></p>
  <button type="button" class="visitor-order-skip" id="visitorOrderSkip">{SCENE.orderSkip}</button>
  <div id="visitorOrderComplete" class="visitor-order-choices" hidden>
    <button type="button" id="visitorOrderAgain">{SCENE.orderEatAgain}</button>
    <button type="button" id="visitorOrderDone">{SCENE.orderDone}</button>
  </div>
</aside>
<div class="visitor-order" id="visitorOrderReopenPanel" hidden>
  <button type="button" id="visitorOrderReopen">{SCENE.orderReopen}</button>
</div>
<div class="hint" id="hint">{SCENE.hint}</div>
<div class="credit">{SCENE.credit}</div>

<script>
  import { initScene } from '../lib/scene.js';

  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const loading = document.getElementById('loading');
  const motionControl = document.getElementById('sceneMotionControl') as HTMLButtonElement | null;
  const motionLabel = motionControl?.querySelector('span');
  const motionPreferenceKey = 'nightbowl:scene-motion';
  let storageAvailable = true;
  let savedMotionPaused = false;

  try {
    savedMotionPaused = localStorage.getItem(motionPreferenceKey) === 'paused';
  } catch {
    storageAvailable = false;
  }

  type MotionState = { manualPaused: boolean; systemReduced: boolean; paused: boolean };
  type SceneControls = {
    setBookOpen(v: boolean): void;
    setMotionPaused(v: boolean): MotionState;
    getMotionState(): MotionState;
    dispose(): void;
  };
  let controls: SceneControls | null = null;

  function setMotionControl(state: MotionState | 'loading' | 'unavailable') {
    if (!motionControl || !motionLabel) return;
    if (state === 'loading' || state === 'unavailable') {
      const loadingState = state === 'loading';
      motionControl.disabled = true;
      motionControl.dataset.state = state;
      motionControl.setAttribute('aria-pressed', 'false');
      motionControl.setAttribute('aria-label', loadingState ? 'Scene motion loading' : 'Scene motion unavailable');
      motionControl.title = loadingState ? 'Scene motion is loading' : 'The 3D scene is unavailable';
      motionLabel.textContent = loadingState ? 'Motion loading' : 'Motion unavailable';
      return;
    }
    motionControl.dataset.state = state.paused ? 'paused' : 'playing';
    motionControl.setAttribute('aria-pressed', String(state.paused));
    if (state.systemReduced) {
      motionControl.disabled = true;
      motionControl.setAttribute('aria-label', 'Scene motion reduced by system settings');
      motionControl.title = 'Your reduced-motion system setting keeps the scene still';
      motionLabel.textContent = 'Motion reduced';
      return;
    }
    motionControl.disabled = false;
    const action = state.manualPaused ? 'Resume scene motion' : 'Pause scene motion';
    motionControl.setAttribute('aria-label', action);
    motionControl.title = storageAvailable ? action : `${action}. Preference applies to this visit only`;
    motionLabel.textContent = state.manualPaused ? 'Resume motion' : 'Pause motion';
  }

  setMotionControl('loading');

  function onBookState(e: Event) {
    controls?.setBookOpen((e as CustomEvent).detail);
    if (controls) setMotionControl(controls.getMotionState());
  }

  function sceneUnavailable() {
    controls?.dispose();
    controls = null;
    delete (window as any).__nightbowl;
    document.removeEventListener('nb:bookstate', onBookState);
    canvas.removeEventListener('webglcontextlost', onContextLost);
    if (loading) {
      loading.textContent = (loading as HTMLElement).dataset.error || 'Scene unavailable';
      (loading as HTMLElement).style.letterSpacing = '0.08em';
      loading.classList.remove('gone');
      loading.classList.add('failed');
    }
    canvas.hidden = true;
    setMotionControl('unavailable');
  }

  function onContextLost(e: Event) {
    e.preventDefault();
    // Content remains usable. A reload creates a clean scene, rather than
    // restoring abandoned meal state on a possibly unstable graphics context.
    sceneUnavailable();
  }

  function boot() {
    try {
      let sceneContent: any = { chatter: { cook: [], diner: [] }, labels: {}, menuItems: [] };
      try { sceneContent = JSON.parse(document.getElementById('nbSceneContent')!.textContent!); } catch (e) {}
      controls = initScene(canvas, (key: string) => {
        document.dispatchEvent(new CustomEvent('nb:open', { detail: key }));
      }, { ...sceneContent, motionPaused: savedMotionPaused });
    } catch (err) {
      console.error(err);
      sceneUnavailable();
      return;
    }
    canvas.addEventListener('webglcontextlost', onContextLost);
    document.addEventListener('nb:bookstate', onBookState);
    // The menu controller runs while the HTML is parsed, before this module.
    // Synchronise events that fired while the scene bundle was still loading.
    controls.setBookOpen(document.getElementById('book')?.classList.contains('open') ?? false);
    setMotionControl(controls.getMotionState());
    // only reachable when explicitly asked for, so normal loads stay clean
    if (location.search.includes('nbtest')) (window as any).__nightbowl = controls;
    loading?.classList.add('gone');
  }

  motionControl?.addEventListener('click', () => {
    if (!controls) return;
    const current = controls.getMotionState();
    if (current.systemReduced) return;
    const next = controls.setMotionPaused(!current.manualPaused);
    try {
      localStorage.setItem(motionPreferenceKey, next.manualPaused ? 'paused' : 'playing');
    } catch {
      storageAvailable = false;
    }
    setMotionControl(next);
  });

  if ('fonts' in document) {
    let done = false;
    const go = () => { if (!done) { done = true; boot(); } };
    (document as any).fonts.ready.then(go);
    setTimeout(go, 1400);
  } else {
    boot();
  }
</script>

<style>
  .scene-motion-control {
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    top: max(20px, env(safe-area-inset-top));
    z-index: 20;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid rgba(247, 240, 226, 0.22);
    border-radius: 999px;
    color: rgba(247, 240, 226, 0.82);
    background: rgba(12, 10, 15, 0.76);
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    font: 500 10px/1.2 'Space Mono', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .scene-motion-control:hover:not(:disabled) { background: rgba(42, 34, 44, 0.9); }
  .scene-motion-control:disabled { cursor: default; opacity: 0.68; }
  .scene-motion-control[data-state='paused'] { border-color: rgba(239, 154, 76, 0.55); }

  @media (prefers-reduced-motion: reduce) {
    .scene-motion-control { transition: none; }
  }
</style>
