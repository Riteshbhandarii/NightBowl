---
// Kitchen Log email sign-up. A centred card that appears a moment after the visitor first
// moves, scrolls or touches the page, so they have to answer it. It is a proper modal dialog:
// focus moves into it and stays there, Escape or "No thanks" closes it, and it stays away for
// 30 days after that (for good once someone has signed up). It only renders when a Buttondown
// username is set in src/content/site/log.json.
import { LOG } from '../data/content';
const user = LOG.newsletterButtondown?.trim();
---

{user && (
  <>
    <div class="sub-pop" id="subPop" hidden>
      <div class="sub-pop-card" role="dialog" aria-modal="true" aria-labelledby="subPopTitle">
        <button type="button" class="sub-pop-close" id="subPopClose" aria-label={LOG.popupDismiss}>×</button>
        <div id="subPopAsk">
          <h2 id="subPopTitle">{LOG.popupTitle}</h2>
          <p>{LOG.popupLine}</p>
          <form action={`https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(user)}`} method="post" target="nbSubFrame" id="subPopForm">
            <input type="hidden" name="embed" value="1" />
            <input type="email" name="email" id="subPopEmail" aria-label="Email" placeholder={LOG.popupPlaceholder} autocomplete="email" required />
            <button type="submit">{LOG.popupAction}</button>
          </form>
          <p class="sub-pop-fine"><button type="button" class="sub-pop-no" id="subPopNo">{LOG.popupDismiss}</button> · <a href="/privacy/">{LOG.popupPrivacy}</a></p>
        </div>
        <p class="sub-pop-thanks" id="subPopThanks" role="status" hidden>{LOG.popupThanks}</p>
      </div>
    </div>
    <iframe name="nbSubFrame" title="" tabindex="-1" aria-hidden="true" hidden></iframe>
    <script>
      const KEY = 'nb-subscribe';
      const wrap = document.getElementById('subPop');
      if (wrap && !location.search.includes('nbtest')) {
        const saved = (() => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } })();
        const quiet = saved && (saved.state === 'subscribed' || Date.now() - saved.at < 30 * 86400000);
        if (!quiet) {
          const email = document.getElementById('subPopEmail') as HTMLInputElement;
          const remember = (state: string) => { try { localStorage.setItem(KEY, JSON.stringify({ state, at: Date.now() })); } catch { /* storage blocked */ } };
          let shown = false;
          let timer = 0;
          let returnTo: Element | null = null;

          const show = () => {
            if (shown) return;
            shown = true;
            stopWaiting();
            returnTo = document.activeElement;
            wrap.hidden = false;
            document.documentElement.style.overflow = 'hidden';
            requestAnimationFrame(() => { wrap.classList.add('in'); email.focus({ preventScroll: true }); });
          };
          // "Starts moving": the first real movement, scroll, touch or key press. A short beat later it opens.
          let lastX = -1, lastY = -1;
          const begin = () => { if (!timer && !shown) timer = window.setTimeout(show, 1200); };
          const onMove = (event: PointerEvent) => {
            if (lastX < 0) { lastX = event.clientX; lastY = event.clientY; return; }
            if (Math.abs(event.clientX - lastX) + Math.abs(event.clientY - lastY) > 12) begin();
          };
          function stopWaiting() {
            removeEventListener('pointermove', onMove);
            removeEventListener('scroll', begin);
            removeEventListener('pointerdown', begin);
            removeEventListener('keydown', begin);
            clearTimeout(timer);
          }
          addEventListener('pointermove', onMove, { passive: true });
          addEventListener('scroll', begin, { passive: true });
          addEventListener('pointerdown', begin, { passive: true });
          addEventListener('keydown', begin);

          const hide = (state: string) => {
            remember(state);
            wrap.classList.remove('in');
            document.documentElement.style.overflow = '';
            setTimeout(() => { wrap.hidden = true; (returnTo as HTMLElement | null)?.focus?.({ preventScroll: true }); }, 250);
          };
          document.getElementById('subPopClose')?.addEventListener('click', () => hide('dismissed'));
          document.getElementById('subPopNo')?.addEventListener('click', () => hide('dismissed'));
          wrap.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') { hide('dismissed'); return; }
            if (event.key !== 'Tab') return;
            // Keep Tab inside the dialog while it is open.
            const focusable = [...wrap.querySelectorAll<HTMLElement>('button, input, a[href]')].filter((el) => !el.closest('[hidden]'));
            const first = focusable[0], last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
            else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
          });
          document.getElementById('subPopForm')?.addEventListener('submit', () => {
            remember('subscribed');
            document.getElementById('subPopAsk')!.hidden = true;
            document.getElementById('subPopThanks')!.hidden = false;
            setTimeout(() => hide('subscribed'), 3500);
          });
        }
      }
    </script>
  </>
)}
