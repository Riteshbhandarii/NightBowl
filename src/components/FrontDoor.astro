---
// Who runs the stall, in plain HTML over the scene, so it reads before
// and without the 3D load.
import { CONTACT, NAVIGATION, SITE } from '../data/content';
---

<aside class="front-door" aria-label={`About ${SITE.ownerName}`}>
  <p class="front-door-name">{SITE.ownerName}</p>
  <p class="front-door-role">{SITE.role}</p>
  <p class="front-door-meta">{SITE.availability}</p>
  <p class="front-door-line">{SITE.positioning}</p>
  <div class="front-door-actions">
    <a href="/menu/" data-open="menu" aria-haspopup="dialog">See the work</a>
    {CONTACT.cv && <a href={CONTACT.cv} download>{NAVIGATION.cv}</a>}
    {CONTACT.email && <a href={`mailto:${encodeURIComponent(CONTACT.email)}`}>Email</a>}
  </div>
</aside>

<style>
  .front-door {
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    top: calc(max(20px, env(safe-area-inset-top)) + 58px);
    z-index: 19;
    width: min(360px, calc(100vw - 32px - env(safe-area-inset-left) - env(safe-area-inset-right)));
    padding: 16px 18px;
    border: 1px solid rgba(247, 240, 226, 0.22);
    border-radius: 6px;
    background: rgba(12, 10, 15, 0.82);
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    color: #f6efe0;
  }
  .front-door p { margin: 0; }
  .front-door-name { font: 700 22px/1.15 'Zilla Slab', Georgia, serif; }
  .front-door-role { margin-top: 4px !important; font: 500 13px/1.45 'Hanken Grotesk', system-ui, sans-serif; }
  .front-door-meta {
    margin-top: 6px !important;
    font: 400 10px/1.5 'Space Mono', monospace;
    letter-spacing: 0.06em;
    color: rgba(247, 240, 226, 0.68);
  }
  .front-door-line {
    margin-top: 10px !important;
    font: italic 400 14px/1.45 'Zilla Slab', Georgia, serif;
    color: #ef9a4c;
  }
  .front-door-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .front-door-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid rgba(247, 240, 226, 0.28);
    border-radius: 999px;
    color: #f6efe0;
    font: 500 11px/1 'Space Mono', monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .front-door-actions a:first-child { border-color: #ef9a4c; background: rgba(239, 154, 76, 0.16); }
  .front-door-actions a:hover { background: rgba(247, 240, 226, 0.14); }

  :global(.menu-preview) .front-door { top: calc(max(20px, env(safe-area-inset-top)) + 122px); }

  /* Phones: keep who and what, drop the quote so the sign stays visible. */
  @media (max-width: 860px) {
    .front-door { padding: 12px 14px; }
    .front-door-line { display: none; }
    .front-door-actions { margin-top: 10px; }
  }
  /* Phone landscape: a single line in the top row; the top bar already has CV and the menu. */
  @media (max-height: 520px) {
    .front-door {
      top: max(20px, env(safe-area-inset-top));
      left: calc(max(16px, env(safe-area-inset-left)) + 124px);
      width: auto;
      max-width: calc(100vw - 380px);
      min-height: 44px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 16px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .front-door-name { font-size: 15px; }
    .front-door-role { margin-top: 0 !important; font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
    .front-door-meta, .front-door-line, .front-door-actions { display: none; }
  }
  /* The order panel shares the left edge; give it the space while it is open on short screens. */
  @media (max-height: 640px) {
    :global(#visitorOrder:not([hidden]) ~ .front-door) { display: none; }
  }
</style>
