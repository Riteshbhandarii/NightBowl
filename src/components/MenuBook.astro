---
import { getCollection } from 'astro:content';
import BillLinks from './BillLinks.astro';
import { SITE, NAVIGATION, MENU, GUIDE, SPECIALS, BILL, LOG } from '../data/content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byCourse = (c: string) => projects.filter((p) => p.data.course === c);
const mains = byCourse('mains');
const smallPlates = byCourse('small-plates');
const offMenu = byCourse('off-menu');

const posts = (await getCollection('posts')).sort(
  (a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const postSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const readingTime = (body = '') => Math.max(1, Math.ceil(body.trim().split(/\s+/).filter(Boolean).length / 200));

const anyDraft =
  projects.some((p) => p.data.draftCopy) || GUIDE.draftCopy || SPECIALS.draftCopy || BILL.draftCopy;
---

<div class="backdrop" id="backdrop"></div>
<div class="book-wrap">
  <div class="book" id="book" role="dialog" aria-modal="false" aria-hidden="true" inert aria-label={`${SITE.name} menu`}>
    <button class="book-close" id="bookClose" aria-label="Close menu">×</button>
    <div class="book-inner">
      <div class="page left" id="pageLeft"></div>
      <div class="page right" id="pageRight"></div>
    </div>
    <div class="page-turn" id="pageTurn" aria-hidden="true" inert></div>
    <div class="cover" aria-hidden="true">
      <div class="seal">{SITE.name.charAt(0).toUpperCase()}</div>
      <h1>{SITE.name}</h1>
      <p>{SITE.coverLine}</p>
      <span class="tap">{SITE.coverPrompt}</span>
    </div>
    <nav class="tabs" id="tabs" aria-label="Menu sections">
      <button data-tab="menu">{NAVIGATION.menu}</button>
      <button data-tab="guide">{NAVIGATION.guide}</button>
      <button data-tab="log">{NAVIGATION.log}</button>
      <button data-tab="bill">{NAVIGATION.bill}</button>
    </nav>
  </div>
</div>

{/* ---- pre-rendered section content; the client script moves it into the pages ---- */}
<div id="sectionData" hidden>
  <section data-sec="menu">
    <div class="pg">
      <div data-side="l">
        <span class="eyebrow">{SITE.name} — est. {SITE.establishedYear}</span>
        <h2>{MENU.title}</h2>
        <p class="sub">{MENU.subtitle}</p>
        <p>{MENU.intro}</p>
        <div class="special">
          <h3>{SPECIALS.title}</h3>
          {SPECIALS.items.map((it) => (
            <div class="item">
              <div class="row"><span class="name">{it.name}</span><span class="leader"></span><span class="tag">{it.note}</span></div>
              <p class="desc">{it.line}</p>
            </div>
          ))}
        </div>
      </div>
      <div data-side="r">
        <div class="course">
          <h3>{MENU.mainsTitle}</h3>
          <p class="cnote">{MENU.mainsNote}</p>
          {mains.map((p) => (
            <div class="item">
              <div class="row"><span class="name">{p.data.name}</span><span class="leader"></span><span class="tag">{p.data.tag}</span></div>
              <p class="desc">
                {p.data.summary}{' '}
                {p.data.status === 'published' && <a href={`/menu/${p.id.replace(/\.(md|mdx)$/, '')}/`}>Case study →</a>}
                {p.data.status === 'published' && p.data.sourceUrl && ' · '}
                {p.data.sourceUrl && <a href={p.data.sourceUrl} target="_blank" rel="noopener">Source code ↗</a>}
                {(p.data.status === 'published' || p.data.sourceUrl) && p.data.demoUrl && ' · '}
                {p.data.demoUrl && <a href={p.data.demoUrl} target="_blank" rel="noopener">Live demo ↗</a>}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="pg">
      <div data-side="l">
        <div class="course">
          <h3>{MENU.smallPlatesTitle}</h3>
          <p class="cnote">{MENU.smallPlatesNote}</p>
          {smallPlates.map((p) => (
            <div class="item">
              <div class="row"><span class="name">{p.data.name}</span><span class="leader"></span><span class="tag">{p.data.tag}</span></div>
              <p class="desc">
                {p.data.summary}{' '}
                {p.data.status === 'published' && <a href={`/menu/${p.id.replace(/\.(md|mdx)$/, '')}/`}>Case study →</a>}
                {p.data.status === 'published' && p.data.sourceUrl && ' · '}
                {p.data.sourceUrl && <a href={p.data.sourceUrl} target="_blank" rel="noopener">Source code ↗</a>}
                {(p.data.status === 'published' || p.data.sourceUrl) && p.data.demoUrl && ' · '}
                {p.data.demoUrl && <a href={p.data.demoUrl} target="_blank" rel="noopener">Live demo ↗</a>}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div data-side="r">
        <div class="course">
          <h3>{MENU.offMenuTitle}</h3>
          <p class="cnote">{MENU.offMenuNote}</p>
          {offMenu.map((p) => (
            <div class="item">
              <div class="row"><span class="name">{p.data.name}</span><span class="leader"></span><span class="tag">{p.data.tag}</span></div>
              <p class="desc">
                {p.data.summary}{' '}
                {p.data.status === 'published' && <a href={`/menu/${p.id.replace(/\.(md|mdx)$/, '')}/`}>Case study →</a>}
                {p.data.status === 'published' && p.data.sourceUrl && ' · '}
                {p.data.sourceUrl && <a href={p.data.sourceUrl} target="_blank" rel="noopener">Source code ↗</a>}
                {(p.data.status === 'published' || p.data.sourceUrl) && p.data.demoUrl && ' · '}
                {p.data.demoUrl && <a href={p.data.demoUrl} target="_blank" rel="noopener">Live demo ↗</a>}
              </p>
            </div>
          ))}
        </div>
        <p class="sub" style="margin-top:20px">{MENU.closing}</p>
      </div>
    </div>
  </section>

  <section data-sec="guide">
    <div class="pg">
      <div data-side="l">
        <span class="eyebrow">{GUIDE.eyebrow}</span>
        <h2>{GUIDE.title}</h2>
        <p class="sub">{GUIDE.intro}</p>
        {GUIDE.portrait && <div class="portrait"><img src={GUIDE.portrait} alt={GUIDE.portraitAlt} width="640" height="640" loading="lazy" decoding="async" /></div>}
      </div>
      <div data-side="r">
        {GUIDE.body.map((para) => <p>{para}</p>)}
        <p style="margin-top:16px">
          <a href={SITE.github} target="_blank" rel="noopener" style="font-family:'Space Mono',monospace;font-size:11px;color:var(--accent)">{GUIDE.githubLabel}</a>
        </p>
      </div>
    </div>
  </section>

  <section data-sec="log">
    <div class="pg">
      <div data-side="l">
        <div class="log-sheet log-sheet-intro">
          <span class="eyebrow">{LOG.eyebrow}</span>
          <h2>{LOG.title}</h2>
          <p class="sub">{LOG.menuSubtitle}</p>
          <p>{LOG.menuIntro}</p>
          <a class="log-index-link" href="/log/">{LOG.indexLinkLabel}</a>
        </div>
      </div>
      <div data-side="r">
        <div class="log-sheet log-sheet-list">
          {posts.map((post) => (
            <article class:list={['logline', { draft: post.data.status === 'draft' }]}>
              <div class="log-meta">
                <time>{post.data.status === 'published' ? fmtDate(post.data.date) : LOG.draftDateLabel}</time>
                <span>{readingTime(post.body)} {LOG.readingSuffix}</span>
              </div>
              <h3>
                {post.data.status === 'published'
                  ? <a href={`/log/${postSlug(post.id)}/`}>{post.data.title}</a>
                  : post.data.title}
              </h3>
              <p>{post.data.excerpt}</p>
              {(post.data.tags ?? []).length > 0 && (
                <ul class="log-tags" aria-label="Tags">
                  {(post.data.tags ?? []).map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section data-sec="bill">
    <div class="pg">
      <div data-side="l">
        <span class="eyebrow">{BILL.eyebrow}</span>
        <h2>{BILL.title}</h2>
        <p class="sub">{BILL.intro}</p>
        {!BILL.cvReady && <p>{BILL.emptyCvMessage}</p>}
      </div>
      <div data-side="r">
        <ul class="bill">
          {BILL.rows.map(([k, v]) => (
            <li><b>{k}</b><span>{v}</span></li>
          ))}
          <BillLinks receipt />
        </ul>
        <p class="total">{BILL.total}</p>
      </div>
    </div>
  </section>

  {anyDraft && <p class="draft" data-draft>{SITE.draftStamp}</p>}
</div>

<!-- This controller must run while the HTML is parsed. A module here is ordered
     behind the much larger scene module, leaving the painted menu inert while
     that bundle downloads and executes. Keep this script dependency-free. -->
<script is:inline>
(() => {
  const book = document.getElementById('book');
  const backdrop = document.getElementById('backdrop');
  const pageLeft = document.getElementById('pageLeft');
  const pageRight = document.getElementById('pageRight');
  const pageTurn = document.getElementById('pageTurn');
  const tabsEl = document.getElementById('tabs');
  const closeBtn = document.getElementById('bookClose');
  const cover = book.querySelector('.cover');
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileLayout = window.matchMedia('(max-width: 860px)');

  const draftHtml = document.querySelector('#sectionData [data-draft]')?.outerHTML ?? '';

  // parse the pre-rendered content into { key: [ {l, r}, ... ] }
  const SECTIONS = {};
  document.querySelectorAll('#sectionData section[data-sec]').forEach((sec) => {
    const key = sec.dataset.sec;
    SECTIONS[key] = [...sec.querySelectorAll(':scope > .pg')].map((pg) => ({
      l: pg.querySelector('[data-side="l"]')?.innerHTML ?? '',
      r: pg.querySelector('[data-side="r"]')?.innerHTML ?? '',
    }));
  });

  let isOpen = false;
  let curTab = null;
  let curPage = 0;
  let lastFocus = null;
  let flipTimer = null;
  let focusTimer = null;

  function cancelOpenTimers() {
    clearTimeout(flipTimer);
    clearTimeout(focusTimer);
  }

  function render(withTurn) {
    const pages = SECTIONS[curTab] || [];
    const pg = pages[curPage] || { l: '', r: '' };
    const multi = pages.length > 1;
    const mobile = mobileLayout.matches;
    const lastPage = curPage >= pages.length - 1;

    if (withTurn && !REDUCED && !mobile) {
      pageTurn.innerHTML =
        '<div class="page right" style="position:absolute;inset:0;overflow:hidden">' + pageRight.innerHTML + '</div>';
      pageTurn.classList.remove('run');
      void pageTurn.offsetWidth;
      pageTurn.classList.add('run');
      setTimeout(() => pageTurn.classList.remove('run'), 640);
    }

    // draft stamp goes on the last visible page
    const stamp = lastPage ? draftHtml : '';
    if (mobile) {
      pageLeft.innerHTML = '';
      pageRight.innerHTML = pg.l + '<div style="height:14px"></div>' + pg.r + stamp;
    } else {
      pageLeft.innerHTML = pg.l;
      pageRight.innerHTML = pg.r + stamp;
    }
    pageLeft.dataset.section = curTab;
    pageRight.dataset.section = curTab;
    pageLeft.scrollTop = 0;
    pageRight.scrollTop = 0;

    if (multi) {
      const b = document.createElement('button');
      b.className = 'pageflip-hint';
      b.textContent = lastPage ? '← back a page' : 'turn the page →';
      b.addEventListener('click', () => {
        curPage = lastPage ? 0 : curPage + 1;
        render(true);
      });
      pageRight.appendChild(b);
    }
  }

  function setTab(tab, fromClick) {
    if (!SECTIONS[tab]) return;
    curTab = tab;
    curPage = 0;
    [...tabsEl.children].forEach((c) =>
      c.classList.toggle('active', c.dataset.tab === tab)
    );
    render(fromClick && isOpen);
  }

  function sectionFromUrl() {
    const section = location.hash.slice(1);
    return Object.prototype.hasOwnProperty.call(SECTIONS, section) ? section : null;
  }

  function recordSection(section) {
    const url = new URL(location.href);
    url.hash = section || '';
    if (url.href !== location.href) {
      history.pushState(history.state, '', url);
    }
  }

  function open(tab, updateUrl = true) {
    cancelOpenTimers();
    if (!isOpen) lastFocus = document.activeElement;
    const section = Object.prototype.hasOwnProperty.call(SECTIONS, tab) ? tab : 'menu';
    setTab(section, false);
    if (updateUrl) recordSection(section);
    book.inert = false;
    book.removeAttribute('aria-hidden');
    book.setAttribute('aria-modal', 'true');
    backdrop.classList.add('open');
    book.classList.add('open');
    isOpen = true;
    document.dispatchEvent(new CustomEvent('nb:bookstate', { detail: true }));
    if (REDUCED) {
      book.classList.add('flipped');
    } else {
      flipTimer = setTimeout(() => { if (isOpen) book.classList.add('flipped'); }, 180);
    }
    focusTimer = setTimeout(() => { if (isOpen) closeBtn.focus(); }, 260);
  }

  function close(updateUrl = true) {
    cancelOpenTimers();
    book.classList.remove('open', 'flipped');
    backdrop.classList.remove('open');
    isOpen = false;
    if (updateUrl && sectionFromUrl()) recordSection(null);
    document.dispatchEvent(new CustomEvent('nb:bookstate', { detail: false }));
    const opener = lastFocus?.isConnected && lastFocus.tabIndex >= 0 && lastFocus.getClientRects().length ? lastFocus
      : [...document.querySelectorAll('.topbar [data-open]')].find((el) => el.getClientRects().length);
    opener?.focus();
    book.inert = true;
    book.setAttribute('aria-hidden', 'true');
    book.setAttribute('aria-modal', 'false');
  }

  mobileLayout.addEventListener('change', () => {
    if (!curTab) return;
    const focused = document.activeElement;
    const href = focused?.getAttribute('href');
    const pageControl = focused?.classList.contains('pageflip-hint');
    render(false);
    if (isOpen && focused && !focused.isConnected) {
      const replacement = pageControl ? pageRight.querySelector('.pageflip-hint')
        : [...book.querySelectorAll('a[href]')].find((a) => a.getAttribute('href') === href);
      (replacement || closeBtn).focus({ preventScroll: true });
    }
  });

  closeBtn.addEventListener('click', () => close());
  backdrop.addEventListener('click', () => close());
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) close(); });
  cover.addEventListener('click', () => book.classList.add('flipped'));
  tabsEl.addEventListener('click', (e) => {
    const b = e.target instanceof Element ? e.target.closest('button[data-tab]') : null;
    if (b) {
      setTab(b.dataset.tab, true);
      recordSection(b.dataset.tab);
    }
  });
  document.addEventListener('nb:open', (e) => open(e.detail));
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = e.target instanceof Element ? e.target.closest('a[data-open]') : null;
    if (!link || link.target || link.hasAttribute('download') || !SECTIONS[link.dataset.open]) return;
    e.preventDefault();
    open(link.dataset.open);
  });

  function restoreSection() {
    const section = sectionFromUrl();
    if (section) {
      if (!isOpen) open(section, false);
      else if (curTab !== section) setTab(section, false);
    } else if (isOpen) close(false);
  }
  window.addEventListener('popstate', restoreSection);
  window.addEventListener('hashchange', restoreSection);
  restoreSection();

  book.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen) return;
    const f = [...book.querySelectorAll('button, a[href], [tabindex]')]
      .filter((el) => !el.closest('[inert]') && !el.disabled && el.tabIndex >= 0 && el.getClientRects().length);
    if (!f.length) return;
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
})();
</script>
