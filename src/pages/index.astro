---
import Base from '../layouts/Base.astro';
import Stall from '../components/Stall.astro';
import HomeSections from '../components/HomeSections.astro';
import { SITE } from '../data/content';
---

<Base title={SITE.name} description={SITE.homeDescription} bodyClass="home-page">
  <script is:inline>if (!/[?&]nbtest=1/.test(location.search)) document.body.classList.add('cinematic');</script>
  <Stall />
  <HomeSections />
</Base>
