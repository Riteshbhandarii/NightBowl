# Production owner sign-in (the © in the footer -> /admin). One password, no GitHub login.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=          # any long random string; signs the sign-in cookie
OWNER_GITHUB_TOKEN=            # fine-grained token, Contents read/write on this repo only
# Keystatic refuses to start without these; they are never used for sign-in. Any text works.
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=unused
KEYSTATIC_GITHUB_CLIENT_SECRET=unused

# Kitchen Log emails (owner subscriber page at /admin/subscribers). Buttondown -> Settings -> API.
# In production set it as a Worker secret: npx wrangler secret put BUTTONDOWN_API_KEY
BUTTONDOWN_API_KEY=
