# Production-only GitHub App credentials used by Keystatic.
# Run the local setup at /admin first, or create a GitHub App following docs/development.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Kitchen Log emails (owner subscriber page at /admin/subscribers). Buttondown -> Settings -> API.
# In production set it as a Worker secret: npx wrangler secret put BUTTONDOWN_API_KEY
BUTTONDOWN_API_KEY=
